{
  "name": "@sheetx/web-component",
  "version": "0.0.0",
  "license": "MIT",
  "description": "适配层：Custom Elements 封装（Lit wrapper：sheetx-grid / sheetx-spreadsheet）",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./cdn": {
      "types": "./src/cdn.ts",
      "default": "./src/cdn.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@sheetx/core": "workspace:*",
    "@sheetx/data-adapter": "workspace:*",
    "@sheetx/grid": "workspace:*",
    "@sheetx/spreadsheet": "workspace:*",
    "@sheetx/validation": "workspace:*",
    "lit": "^3.3.3",
    "@sheetx/ui": "workspace:*"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./cdn": "./dist/sheetx.iife.js"
    }
  }
}
