{
  "name": "@sheetx/ui",
  "version": "0.0.0",
  "license": "MIT",
  "description": "SheetX 通用 UI 组件与外观预设（工具栏/公式栏/状态栏/右键菜单），供 Grid 与 Spreadsheet 共用",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@sheetx/core": "workspace:*",
    "@sheetx/themes": "workspace:*"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
